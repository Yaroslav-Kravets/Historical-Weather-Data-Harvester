{
  "HistoricalWeatherFilesRoot": "/path/to/weather/html/root-or-archive.7z",
  "RunInParallel": false,
  "RunTimeNormalization": true,
  "RunHtmlLogCsvComparison": true,
  "RunAnalysis": true,
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Async" ],
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "restrictedToMinimumLevel": "Debug",
                "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
              }
            }
          ]
        }
      }
    ],
    "File": {
      "MinimumLevel": "Debug",
      "OutputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] [{SourceContextShort}] {Message:lj}{NewLine}{Exception}"
    }
  }
}
